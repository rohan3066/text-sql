APP_ENV=development

# Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Database credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=textsql_reader
MYSQL_PASSWORD=readerpassword

# Admin account for system queries (like history, saving queries, dashboard meta)
MYSQL_ADMIN_USER=textsql_admin
MYSQL_ADMIN_PASSWORD=adminpassword
MYSQL_ROOT_PASSWORD=rootpassword

# JWT Security
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_for_security
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
